[BioUI.ini Engine.BioSFManager]
; mod settings menu entry
+HandlerLibrary=(Tag=MSM,ZOrder=212,HandlerClass="Handler.ModHandler_ModSettingsMenu",PanelResource="ModMenu.ModMenu", bRequiresScaling=true)

[BioUI.ini ModSettings_Submenus_MSM.ModSettingsSubmenu_Root]
sTitle=Mod Settings Menu
sSubtitle=Select a mod to configure
sDefaultActionText=menu default action
++menuItems=(sCenterText="item 1",sDescriptionTitleText="descrition title 1" sDescriptionText="actual description 1",sActionText="item 1 action")
++menuItems=(sCenterText="item 2",sDescriptionTitleText="descrition title 2" sDescriptionText="actual description 2")
++menuItems=(sCenterText="item 3",sDescriptionTitleText="descrition title 3" sDescriptionText="actual description 3")
++menuItems=(sCenterText="item 4",sDescriptionTitleText="descrition title 4" sDescriptionText="actual description 4")
++menuItems=(sCenterText="item 5",sDescriptionTitleText="descrition title 5" sDescriptionText="actual description 5")
++menuItems=(sCenterText="item 6",sDescriptionTitleText="descrition title 6" sDescriptionText="actual description 6",sActionText="item 6 action")
++menuItems=(sCenterText="item 7",sDescriptionTitleText="descrition title 7" sDescriptionText="actual description 7")
++menuItems=(sCenterText="item 8",sDescriptionTitleText="descrition title 8" sDescriptionText="actual description 8")
++menuItems=(sCenterText="item 9",sDescriptionTitleText="descrition title 9" sDescriptionText="actual description 0")
++menuItems=(sCenterText="testing menu",SubMenuClassName="ModSettings_Submenus_MSM.ModSettingsSubmenu_Example1")
++menuItems=(sCenterText="example menu",SubMenuClassName="ModSettings_Submenus_MSM.ModSettingsSubmenu_Example2")
++menuItems=(sCenterText="item 10",Images=("GUI_Codex_Images.Boo_512"))
++menuItems=(sCenterText="item 11",Images=("GUI_Codex_Images.ChefProvisions2_512"))
++menuItems=(sCenterText="item 12")
++menuItems=(sCenterText="item 13")
++menuItems=(sCenterText="item 14")
++menuItems=(sCenterText="item 15")
++menuItems=(sCenterText="item 16")

[BioUI.ini ModSettings_Submenus_MSM.ModSettingsSubmenu_Example1]
sTitle=Example menu
sSubtitle=Example subtitle
; test all the text fields on the item itself
++menuItems=(sLeftText="left text",sCenterText="center text", sRightText="right text", sSecondaryText="secondary")
; test disabled
++menuItems=(sCenterText="this one should be disabled", disabled=true)
; testing hiding an item
++menuItems=(sCenterText="this one should be hidden", hidden=true)
; test enough items to scroll to see if we can reset the scroll position
++menuItems=(sCenterText="item 3")
++menuItems=(sCenterText="item 4")
++menuItems=(sCenterText="item 5")
++menuItems=(sCenterText="item 6")
